{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap-tracker.schema.json",
  "title": "Roadmap Tracker Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roadmaps",
    "sprints"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "description": "2 adds the optional tracking fields (owner, updated, next, evidence, gates, log)."
    },
    "roadmaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "project_id",
              "plan_sha256",
              "approved_plan",
              "ruling"
            ],
            "properties": {
              "schema": {
                "enum": ["aether-roadmap-publication-1", "aether-roadmap-publication-2"]
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "plan_sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "approved_plan": {
                "type": "object"
              },
              "ruling": {
                "type": "object"
              },
              "plan_change": {
                "type": "object"
              }
            },
            "allOf": [{
              "if": {"properties": {"schema": {"const": "aether-roadmap-publication-2"}}},
              "then": {"required": ["plan_change"]},
              "else": {"not": {"required": ["plan_change"]}}
            }]
          },
          "status": {
            "enum": [
              "Active",
              "Planned",
              "Completed",
              "Aborted"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "next": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "log": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "text"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roadmapId",
          "name",
          "description",
          "status",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "roadmapId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "Planned",
              "Open",
              "Closed",
              "Aborted"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "next": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "log": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "text"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "description": "Tracking fields are valid only when schemaVersion is 2 (enforced by tracker_store.validate_data, which also refuses mis-decoded text)."
}
